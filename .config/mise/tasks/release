#!/usr/bin/env bash
#MISE description="Tags current project version and pushes to origin to trigger GitHub Actions release"

set -euo pipefail

if [[ -n "$(git status -s)" ]]; then
  echo "Error: git working directory has uncommitted changes"
  exit 1
fi

BRANCH="$(git branch --show-current)"
if [[ "$BRANCH" != "main" ]]; then
  echo "Error: releases must be cut from 'main' (current: $BRANCH)"
  exit 1
fi

PROJ_VERSION="$(gradle properties -q | grep "^version:" | awk '{print $2}')"
TAG="version/${PROJ_VERSION}"

if git rev-parse "$TAG" >/dev/null 2>&1; then
  echo "Error: tag $TAG already exists"
  exit 1
fi

echo "Creating tag $TAG..."
git tag -a "$TAG" -m "Release $TAG"

echo "Pushing tag $TAG to origin (triggers GitHub Actions release workflow)..."
git push origin "$TAG"

echo "Done! GitHub Actions release workflow triggered."
echo "Monitor workflow at: https://github.com/fnc314/project-collections-gradle-settings-plugin/actions"
